{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "git": {
    "deploymentEnabled": false
  },
  "redirects": [
    {
      "source": "/",
      "destination": "https://programmable.family/docs/developers",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; connect-src 'self'; font-src 'self'; form-action 'none'; frame-ancestors 'none'; img-src 'self'; object-src 'none'; script-src 'self'; style-src 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/schemas/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/abis/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/event-sets/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/specifications/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/openapi/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/deployments/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/schemas/v1",
      "destination": "/schemas/v1/index.json"
    },
    {
      "source": "/schemas/v2",
      "destination": "/schemas/v2/index.json"
    },
    {
      "source": "/v1/status",
      "destination": "/api/v1/status"
    },
    {
      "source": "/v1/manifest",
      "destination": "/api/v1/manifest"
    },
    {
      "source": "/v1/launches",
      "destination": "/api/v1/launches"
    },
    {
      "source": "/v1/launches/:chainId/:tokenAddress",
      "destination": "/api/v1/launches/:chainId/:tokenAddress"
    },
    {
      "source": "/v1/token-list",
      "destination": "/api/v1/token-list"
    },
    {
      "source": "/v2/status",
      "destination": "/api/v2/status"
    },
    {
      "source": "/v2/manifest",
      "destination": "/api/v2/manifest"
    },
    {
      "source": "/v2/manifests/:chainId",
      "destination": "/api/v2/manifests/:chainId"
    },
    {
      "source": "/v2/launches",
      "destination": "/api/v2/launches"
    },
    {
      "source": "/v2/launches/:chainId/:tokenAddress",
      "destination": "/api/v2/launches/:chainId/:tokenAddress"
    },
    {
      "source": "/v2/chains/:chainId/launches/:launchId",
      "destination": "/api/v2/chains/:chainId/launches/:launchId"
    },
    {
      "source": "/api/v2/launches/:launchId",
      "destination": "/api/v2/launch-detail?launchId=:launchId"
    },
    {
      "source": "/v2/token-list",
      "destination": "/api/v2/token-list"
    }
  ]
}
