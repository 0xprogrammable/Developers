{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developers.programmable.family/schemas/v1/launch.schema.json",
  "title": "Programmable launch",
  "type": "object",
  "required": [
    "schemaVersion",
    "launchId",
    "category",
    "chainId",
    "token",
    "launch",
    "verification",
    "capabilities",
    "markets",
    "fees",
    "extensions"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "platformId": {
      "const": "programmable",
      "description": "Stable platform identity assigned by the trusted Programmable projection. This is not creator metadata."
    },
    "launchId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "category": {
      "$ref": "common.schema.json#/$defs/category"
    },
    "chainId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "token": {
      "oneOf": [
        {
          "$ref": "#/$defs/token"
        },
        {
          "type": "null"
        }
      ],
      "description": "ERC-20 convenience projection when the authenticated launch advertises exactly one primary token. Null for truthful project-only launches."
    },
    "assets": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/asset"
      },
      "description": "Identity-first authenticated asset graph. Optional on legacy v1 records."
    },
    "launch": {
      "$ref": "#/$defs/launch"
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "markets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/market"
      }
    },
    "fees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fee"
      }
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "token": {
      "type": "object",
      "required": [
        "address",
        "identityStatus",
        "name",
        "symbol",
        "decimals",
        "totalSupplyRaw",
        "supplyStatus",
        "supplyAsOfBlock",
        "metadata"
      ],
      "properties": {
        "address": {
          "$ref": "common.schema.json#/$defs/evmAddress"
        },
        "identityStatus": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "decimals": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 255
        },
        "totalSupplyRaw": {
          "$ref": "common.schema.json#/$defs/nullableDecimalString"
        },
        "supplyStatus": {
          "enum": [
            "unavailable",
            "observed",
            "verified"
          ]
        },
        "supplyAsOfBlock": {
          "$ref": "common.schema.json#/$defs/nullableDecimalString"
        },
        "metadata": {
          "$ref": "#/$defs/tokenMetadata"
        }
      },
      "additionalProperties": false
    },
    "tokenMetadata": {
      "type": "object",
      "required": [
        "description",
        "imageUrl",
        "links",
        "trustStatus"
      ],
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "imageUrl": {
          "$ref": "common.schema.json#/$defs/nullableHttpsUrl"
        },
        "links": {
          "oneOf": [
            {
              "$ref": "#/$defs/tokenLinks"
            },
            {
              "type": "null"
            }
          ]
        },
        "trustStatus": {
          "enum": [
            "creator-declared",
            "sanitized",
            "unavailable"
          ]
        }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": [
        "assetId",
        "role",
        "identity",
        "provenance",
        "identityEvidenceHash",
        "onchainMetadata",
        "onchainMetadataHash"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "role": {
          "enum": [
            "root",
            "primary-token",
            "secondary-token",
            "pool",
            "hook",
            "controller"
          ]
        },
        "identity": {
          "$ref": "#/$defs/assetIdentity"
        },
        "provenance": {
          "$ref": "#/$defs/assetProvenance"
        },
        "identityEvidenceHash": {
          "$ref": "#/$defs/sha256Digest"
        },
        "onchainMetadata": {
          "oneOf": [
            {
              "$ref": "#/$defs/onchainTokenMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "onchainMetadataHash": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256Digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "assetProvenance": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "launch-produced"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "relationship"
          ],
          "properties": {
            "kind": {
              "const": "protocol-external"
            },
            "relationship": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "relationship",
            "dependencyId",
            "capabilityId",
            "reviewedRole",
            "chainProfileId",
            "identity",
            "expectedRuntimeCodeKeccak256",
            "expectedRuntimeCodeSha256",
            "reviewEvidenceBindingHash",
            "interfaceEvidenceBindingHash",
            "stateObservationIds"
          ],
          "properties": {
            "kind": {
              "const": "adopted-external"
            },
            "relationship": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "dependencyId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "capabilityId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "reviewedRole": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "chainProfileId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "identity": {
              "$ref": "#/$defs/assetIdentity"
            },
            "expectedRuntimeCodeKeccak256": {
              "$ref": "common.schema.json#/$defs/hash32"
            },
            "expectedRuntimeCodeSha256": {
              "$ref": "#/$defs/sha256Digest"
            },
            "reviewEvidenceBindingHash": {
              "$ref": "#/$defs/sha256Digest"
            },
            "interfaceEvidenceBindingHash": {
              "$ref": "#/$defs/sha256Digest"
            },
            "stateObservationIds": {
              "type": "array",
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "assetIdentity": {
      "type": "object",
      "required": [
        "namespace",
        "value"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "additionalProperties": false
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "onchainTokenMetadata": {
      "type": "object",
      "required": [
        "schemaVersion",
        "status",
        "source",
        "evidenceHash"
      ],
      "properties": {
        "schemaVersion": {
          "const": "programmable.discoverable-launch-token-metadata.v2"
        },
        "status": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "source": {
          "const": "finality-resolved-onchain"
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "symbol": {
          "type": "string",
          "maxLength": 64
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "reason": {
          "enum": [
            "onchain-read-unavailable",
            "non-standard-metadata",
            "invalid-metadata"
          ]
        },
        "evidenceHash": {
          "$ref": "#/$defs/sha256Digest"
        }
      },
      "additionalProperties": false
    },
    "tokenLinks": {
      "type": "object",
      "properties": {
        "website": {
          "$ref": "common.schema.json#/$defs/nullableHttpsUrl"
        },
        "x": {
          "$ref": "common.schema.json#/$defs/nullableHttpsUrl"
        },
        "telegram": {
          "$ref": "common.schema.json#/$defs/nullableHttpsUrl"
        },
        "documentation": {
          "$ref": "common.schema.json#/$defs/nullableHttpsUrl"
        },
        "docs": {
          "$ref": "common.schema.json#/$defs/nullableHttpsUrl"
        },
        "github": {
          "$ref": "common.schema.json#/$defs/nullableHttpsUrl"
        }
      },
      "additionalProperties": false
    },
    "launch": {
      "type": "object",
      "required": [
        "status",
        "origin",
        "modelId",
        "modelVersion",
        "publicSubmission",
        "creatorAddress",
        "transactionHash",
        "blockNumber",
        "blockHash",
        "logIndex",
        "timestamp",
        "finality"
      ],
      "properties": {
        "status": {
          "enum": [
            "prelaunch",
            "live",
            "paused",
            "retired"
          ]
        },
        "origin": {
          "$ref": "common.schema.json#/$defs/openIdentifier"
        },
        "modelId": {
          "$ref": "common.schema.json#/$defs/openIdentifier"
        },
        "modelVersion": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "publicSubmission": {
          "type": "boolean"
        },
        "creatorAddress": {
          "$ref": "common.schema.json#/$defs/nullableEvmAddress"
        },
        "transactionHash": {
          "$ref": "common.schema.json#/$defs/nullableHash32"
        },
        "blockNumber": {
          "$ref": "common.schema.json#/$defs/nullableDecimalString"
        },
        "blockHash": {
          "$ref": "common.schema.json#/$defs/nullableHash32"
        },
        "logIndex": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "timestamp": {
          "$ref": "common.schema.json#/$defs/nullableIsoDateTime",
          "description": "Block timestamp enrichment. Null does not hide an otherwise verified launcher event."
        },
        "finality": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "observed",
            "confirmed",
            "finalized",
            "orphaned",
            null
          ]
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": [
        "sourceId",
        "launcherAddress",
        "registryAddress",
        "provenanceStatus",
        "sourceUrl"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "launcherAddress": {
          "$ref": "common.schema.json#/$defs/nullableEvmAddress"
        },
        "registryAddress": {
          "$ref": "common.schema.json#/$defs/nullableEvmAddress"
        },
        "provenanceStatus": {
          "enum": [
            "prelaunch",
            "partial",
            "verified",
            "revoked"
          ]
        },
        "sourceUrl": {
          "$ref": "common.schema.json#/$defs/nullableHttpsUrl"
        }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": [
        "id",
        "version",
        "status",
        "parameters"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/openIdentifier"
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "status": {
          "enum": [
            "active",
            "conditional",
            "inactive"
          ]
        },
        "parameters": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "additionalProperties": {
            "$ref": "#/$defs/parameterValue"
          }
        }
      },
      "additionalProperties": false
    },
    "market": {
      "type": "object",
      "required": [
        "marketId",
        "kind",
        "status",
        "baseTokenAddress",
        "quoteTokenAddress",
        "protocol",
        "poolId",
        "poolAddress",
        "hookAddress",
        "support",
        "adapter",
        "metrics"
      ],
      "properties": {
        "marketId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "$ref": "common.schema.json#/$defs/openIdentifier"
        },
        "status": {
          "enum": [
            "planned",
            "active",
            "paused",
            "closed"
          ]
        },
        "sourceStatus": {
          "enum": [
            "active",
            "paused",
            "closed",
            "verification_pending"
          ]
        },
        "verificationStatus": {
          "enum": [
            "verified",
            "unverified",
            "verification-pending"
          ]
        },
        "verification": {
          "$ref": "#/$defs/marketVerification"
        },
        "baseTokenAddress": {
          "$ref": "common.schema.json#/$defs/nullableEvmAddress"
        },
        "quoteTokenAddress": {
          "$ref": "common.schema.json#/$defs/nullableEvmAddress"
        },
        "protocol": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "poolId": {
          "$ref": "common.schema.json#/$defs/nullableHash32"
        },
        "poolAddress": {
          "$ref": "common.schema.json#/$defs/nullableEvmAddress"
        },
        "hookAddress": {
          "$ref": "common.schema.json#/$defs/nullableEvmAddress"
        },
        "support": {
          "type": "object",
          "required": [
            "discovery",
            "charting",
            "quote",
            "simulation",
            "execution"
          ],
          "properties": {
            "discovery": {
              "enum": [
                "available",
                "unavailable",
                "unknown"
              ]
            },
            "charting": {
              "enum": [
                "available",
                "unavailable",
                "unknown"
              ]
            },
            "quote": {
              "enum": [
                "available",
                "unavailable",
                "unknown"
              ]
            },
            "simulation": {
              "enum": [
                "available",
                "unavailable",
                "unknown"
              ]
            },
            "execution": {
              "enum": [
                "available",
                "unavailable",
                "unknown"
              ]
            }
          },
          "additionalProperties": false
        },
        "adapter": {
          "oneOf": [
            {
              "$ref": "#/$defs/adapter"
            },
            {
              "type": "null"
            }
          ]
        },
        "metrics": {
          "$ref": "#/$defs/marketMetrics"
        },
        "assetReferences": {
          "$ref": "#/$defs/marketAssetReferences"
        },
        "evidenceHash": {
          "$ref": "#/$defs/sha256Digest"
        },
        "uniswapV4": {
          "oneOf": [
            {
              "$ref": "#/$defs/uniswapV4"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "marketVerification": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "verifierAdapterId",
            "verifierBindingHash"
          ],
          "properties": {
            "status": {
              "const": "verified"
            },
            "verifierAdapterId": {
              "$ref": "common.schema.json#/$defs/openIdentifier"
            },
            "verifierBindingHash": {
              "$ref": "#/$defs/sha256Digest"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "verifierAdapterId",
            "verifierBindingHash"
          ],
          "properties": {
            "status": {
              "const": "pending"
            },
            "verifierAdapterId": {
              "type": "null"
            },
            "verifierBindingHash": {
              "type": "null"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "marketAssetReferences": {
      "type": "object",
      "required": [
        "marketAssetId",
        "baseAssetId",
        "quoteAssetId"
      ],
      "properties": {
        "marketAssetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "baseAssetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "quoteAssetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "additionalProperties": false
    },
    "uniswapV4": {
      "type": "object",
      "required": [
        "poolId",
        "poolManager",
        "poolManagerReviewEvidenceBindingHash",
        "poolManagerInterfaceEvidenceBindingHash",
        "poolManagerRuntimeCodeKeccak256",
        "poolManagerRuntimeCodeSha256",
        "currency0AssetId",
        "currency1AssetId",
        "feeRaw",
        "dynamicFee",
        "tickSpacing",
        "hooksAssetId",
        "poolKeyEvidenceHash"
      ],
      "properties": {
        "poolId": {
          "$ref": "common.schema.json#/$defs/hash32"
        },
        "poolManager": {
          "$ref": "#/$defs/assetIdentity"
        },
        "poolManagerReviewEvidenceBindingHash": {
          "$ref": "#/$defs/sha256Digest"
        },
        "poolManagerInterfaceEvidenceBindingHash": {
          "$ref": "#/$defs/sha256Digest"
        },
        "poolManagerRuntimeCodeKeccak256": {
          "$ref": "common.schema.json#/$defs/hash32"
        },
        "poolManagerRuntimeCodeSha256": {
          "$ref": "#/$defs/sha256Digest"
        },
        "currency0AssetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "currency1AssetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "feeRaw": {
          "$ref": "common.schema.json#/$defs/decimalString"
        },
        "dynamicFee": {
          "type": "boolean"
        },
        "tickSpacing": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^(0|-?[1-9][0-9]*)$"
        },
        "hooksAssetId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "poolKeyEvidenceHash": {
          "$ref": "#/$defs/sha256Digest"
        }
      },
      "additionalProperties": false
    },
    "marketMetrics": {
      "type": "object",
      "required": [
        "price",
        "liquidity",
        "volume24h",
        "updatedAt"
      ],
      "properties": {
        "price": {
          "$ref": "#/$defs/metric"
        },
        "liquidity": {
          "$ref": "#/$defs/metric"
        },
        "volume24h": {
          "$ref": "#/$defs/metric"
        },
        "updatedAt": {
          "$ref": "common.schema.json#/$defs/nullableIsoDateTime"
        }
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "required": [
        "value",
        "status"
      ],
      "properties": {
        "value": {
          "$ref": "common.schema.json#/$defs/nullableDecimalAmount"
        },
        "status": {
          "enum": [
            "unavailable",
            "estimated",
            "verified"
          ]
        }
      },
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "required": [
        "kind",
        "version",
        "adapterId",
        "verificationStatus"
      ],
      "properties": {
        "kind": {
          "$ref": "common.schema.json#/$defs/openIdentifier"
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "adapterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "verificationStatus": {
          "enum": [
            "prelaunch",
            "verified",
            "revoked"
          ]
        }
      },
      "additionalProperties": false
    },
    "fee": {
      "type": "object",
      "required": [
        "kind",
        "ratePpm",
        "rateBps",
        "recipient",
        "chargeMode",
        "basis",
        "assetAddress",
        "verificationStatus"
      ],
      "properties": {
        "kind": {
          "$ref": "common.schema.json#/$defs/openIdentifier"
        },
        "ratePpm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "rateBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "recipient": {
          "$ref": "common.schema.json#/$defs/nullableEvmAddress"
        },
        "chargeMode": {
          "enum": [
            "included",
            "added-on-top"
          ]
        },
        "basis": {
          "$ref": "common.schema.json#/$defs/openIdentifier"
        },
        "assetAddress": {
          "$ref": "common.schema.json#/$defs/nullableEvmAddress"
        },
        "verificationStatus": {
          "enum": [
            "prelaunch",
            "verified",
            "revoked"
          ]
        }
      },
      "additionalProperties": false
    },
    "parameterScalar": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 1024
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "parameterValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/parameterScalar"
        },
        {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/parameterScalar"
          }
        }
      ]
    }
  }
}
