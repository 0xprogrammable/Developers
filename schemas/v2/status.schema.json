{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developers.programmable.family/schemas/v2/status.schema.json",
  "title": "Programmable integration service status",
  "type": "object",
  "required": [
    "schemaVersion",
    "apiVersion",
    "service",
    "checkedAt",
    "chainId",
    "chains",
    "classic",
    "custom",
    "customLaunchApi",
    "feeds"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "apiVersion": {
      "const": "2"
    },
    "service": {
      "enum": [
        "operational",
        "degraded",
        "unavailable"
      ]
    },
    "checkedAt": {
      "$ref": "common.schema.json#/$defs/isoDateTime"
    },
    "chainId": {
      "type": "integer",
      "minimum": 1
    },
    "chains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "chainId",
          "caip2",
          "status"
        ],
        "properties": {
          "chainId": {
            "type": "integer",
            "minimum": 1
          },
          "caip2": {
            "type": "string",
            "pattern": "^eip155:[1-9][0-9]*$"
          },
          "status": {
            "enum": [
              "live",
              "prelaunch",
              "retired"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "classic": {
      "$ref": "#/$defs/categoryStatus"
    },
    "custom": {
      "$ref": "#/$defs/categoryStatus"
    },
    "customLaunchApi": {
      "$ref": "#/$defs/customLaunchApi"
    },
    "feeds": {
      "type": "object",
      "required": [
        "manifest",
        "launches",
        "tokenList"
      ],
      "properties": {
        "manifest": {
          "$ref": "#/$defs/feedStatus"
        },
        "launches": {
          "$ref": "#/$defs/feedStatus"
        },
        "tokenList": {
          "$ref": "#/$defs/feedStatus"
        }
      },
      "additionalProperties": true
    },
    "customRegistryPublication": {
      "anyOf": [
        {
          "$ref": "#/$defs/customRegistryPublication"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true,
  "$defs": {
    "categoryStatus": {
      "type": "object",
      "required": [
        "status",
        "note"
      ],
      "properties": {
        "status": {
          "enum": [
            "live",
            "prelaunch",
            "unavailable"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "feedStatus": {
      "enum": [
        "ready",
        "degraded",
        "unavailable"
      ]
    },
    "customLaunchApi": {
      "type": "object",
      "required": [
        "status",
        "readyzUrl",
        "guideUrl",
        "openApiUrl",
        "apiKeyManagementUrl",
        "walletBoundary"
      ],
      "properties": {
        "status": {
          "const": "live"
        },
        "readyzUrl": {
          "const": "https://api.programmable.market/readyz"
        },
        "guideUrl": {
          "const": "https://programmable.market/developers/custom-launch-api-v1.md"
        },
        "openApiUrl": {
          "const": "https://programmable.market/openapi/custom-launch-v1.json"
        },
        "apiKeyManagementUrl": {
          "const": "https://programmable.market/developers/api-keys"
        },
        "walletBoundary": {
          "const": "separate-wallet-signature"
        }
      },
      "additionalProperties": false
    },
    "customRegistryPublication": {
      "type": "object",
      "required": [
        "status",
        "publicSubmissionsEnabled",
        "publicationReady",
        "baselineReady",
        "sourceConfigured",
        "sourceReady",
        "sourceCurrent",
        "expectedSourceId",
        "observedSourceId",
        "activeGeneration",
        "requiresLiveSource",
        "publishedRegistries",
        "baselineLaunches",
        "applicantLaunches"
      ],
      "properties": {
        "status": {
          "enum": [
            "live",
            "prelaunch"
          ]
        },
        "publicSubmissionsEnabled": {
          "type": "boolean"
        },
        "publicationReady": {
          "type": "boolean"
        },
        "baselineReady": {
          "type": "boolean"
        },
        "sourceConfigured": {
          "type": "boolean"
        },
        "sourceReady": {
          "type": "boolean"
        },
        "sourceCurrent": {
          "type": "boolean"
        },
        "expectedSourceId": {
          "enum": [
            "programmable-custom-launch-registry-v3",
            "programmable-custom-launch-registry-v4",
            null
          ]
        },
        "observedSourceId": {
          "enum": [
            "programmable-custom-launch-registry-v3",
            "programmable-custom-launch-registry-v4",
            null
          ]
        },
        "activeGeneration": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[1-9][0-9]*$"
        },
        "requiresLiveSource": {
          "type": "boolean"
        },
        "publishedRegistries": {
          "type": "integer",
          "minimum": 0
        },
        "baselineLaunches": {
          "type": "integer",
          "minimum": 0
        },
        "applicantLaunches": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    }
  }
}
