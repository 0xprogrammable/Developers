# Optional operator-only Ethereum providers used to verify and gap-fill the hosted feed.
# Provide at least one archive-capable HTTPS endpoint in production.
PROGRAMMABLE_ALCHEMY_MAINNET_RPC_URL=https://your-provider.example
PROGRAMMABLE_QUICKNODE_MAINNET_RPC_URL=https://your-secondary-provider.example

# Required in production: a private random value of at least 32 bytes used only to sign opaque cursors.
PROGRAMMABLE_CURSOR_SIGNING_KEY=

# Authenticated finalized Custom Registry feed. These values are deployment inputs;
# do not invent a hostname, binding, audience, or credential. Until every value is
# present, Custom and unfiltered discovery fail closed while `category=classic`
# remains available.
PROGRAMMABLE_REGISTRY_CUSTOM_FEED_URL=https://registry.example/v2/custom-launch-feed
PROGRAMMABLE_REGISTRY_CUSTOM_FEED_AUDIENCE=
PROGRAMMABLE_REGISTRY_CUSTOM_FEED_TARGET_BINDING=sha256:
PROGRAMMABLE_WORKLOAD_TOKEN_ENDPOINT=https://identity.example/token
PROGRAMMABLE_WORKLOAD_ISSUER=
PROGRAMMABLE_WORKLOAD_SUBJECT=

# Prefer a secret-manager-mounted file. Inline injection is supported for
# serverless runtimes that cannot mount a secret file. Configure exactly one.
PROGRAMMABLE_WORKLOAD_SUBJECT_TOKEN_FILE=
# PROGRAMMABLE_WORKLOAD_SUBJECT_TOKEN=

# Live smoke target. Defaults to https://developers.programmable.family.
PROGRAMMABLE_API_BASE=https://developers.programmable.family
